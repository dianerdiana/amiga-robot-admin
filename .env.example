# Root env for docker-compose.yml. Copy to .env and fill in.
# STRICT CONFIG: every key is required; docker compose refuses to start if one is missing.

# PostgreSQL (also injected into the backend container)
DB_USER=amiga
DB_PASSWORD=CHANGE_ME
DB_NAME=amiga_robot_admin
# Host port for the DB, used only by docker-compose.dev.yml (bound to 127.0.0.1).
DB_HOST_PORT=5432

# Public port of the Caddy entry point (80 on EC2).
WEB_PORT=80

# API base URL compiled into the frontend. Empty = same-origin through Caddy (recommended).
NEXT_PUBLIC_API_URL=
