# Backend configuration. Copy to backend/.env and fill in.
#
# STRICT CONFIG: every key below is required; the backend has no built-in defaults.
# A missing key, an invalid value, or a leftover CHANGE_ME aborts startup with a list of
# all problems. Keys documented as "may be empty" must still be present.
# Check your file with:  python -c "import core.config"
#
# Local development (backend on the host, only the DB in Docker):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db   # repo root
#   cd backend
#   .venv/bin/alembic upgrade head                                 # schema + AMIGA Robot system user
#   .venv/bin/python -m scripts.seed_dev --password '<pw>'         # login users, demo clients
#   .venv/bin/uvicorn main:app --reload                            # API + extraction worker
#
# This template is for LOCAL development (all AWS in ap-southeast-1). For EC2 use
# backend/.env.production.example instead. In Docker the DB_* values are overridden by
# docker-compose.yml (DB_HOST=db, credentials from the root .env). See docs/DEPLOYMENT.md.
#
# Never commit real values for DB_PASSWORD, JWT_SECRET_KEY, or AWS credentials.

# ===== Database =====
DB_USER=amiga
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amiga_robot_admin
# Optional full-URL override (takes precedence over DB_*), e.g. for a remote database:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== HTTP =====
# Comma-separated origins allowed to call the API cross-origin. May be empty.
#   Docker / EC2 (same origin through Caddy): leave empty.
#   `npm run dev` on the host against a host backend: http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=
# Serve /docs, /redoc and /openapi.json. Use false on a public server.
API_DOCS_ENABLED=true

# ===== JWT =====
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== AWS credentials =====
# Not part of the app config: boto3 reads them directly.
# EC2: do NOT set them; the instance IAM role provides credentials.
# Local: set the IAM access key pair here (or use ~/.aws).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1

# ===== S3 object storage =====
S3_BUCKET_NAME=bedrock-kb-student2-1791858074
# Region of the bucket (independent of the Bedrock region).
S3_REGION=ap-southeast-1
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
UPLOAD_MAX_BYTES=10485760

# ===== Bedrock extraction =====
# bedrock | fixture (fixture reads stored results from EXTRACTION_FIXTURES_DIR, no AWS needed)
EXTRACTION_MODE=bedrock
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_REGION=ap-southeast-1
BEDROCK_READ_TIMEOUT_SECONDS=30
BEDROCK_MAX_ATTEMPTS=2
# Production (EC2) runs Bedrock in us-east-1 with us. model IDs: see .env.production.example.

# ===== Bedrock Knowledge Base / chatbot =====
BEDROCK_KNOWLEDGE_BASE_ID=YHZIWDET4V
BEDROCK_KNOWLEDGE_BASE_REGION=ap-southeast-1
# May be empty; set both or neither.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_CHAT_MODEL_ID=apac.amazon.nova-lite-v1:0
CHAT_RETRIEVE_TOP_K=5
CHAT_MAX_HISTORY_MESSAGES=12
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_OUTPUT_TOKENS=1000
CHAT_RATE_LIMIT_PER_MINUTE=10

# ===== Extraction worker =====
# Run the worker inside the API process; set to false when running it separately:
#   python -m workers.extraction_worker
EXTRACTION_RUN_IN_API=true
EXTRACTION_WORKER_THREADS=2
EXTRACTION_POLL_SECONDS=2
EXTRACTION_STALE_SECONDS=300
# Relative to the backend folder (must exist when EXTRACTION_MODE=fixture).
EXTRACTION_FIXTURES_DIR=fixtures/extractions

# ===== Validation =====
TOTAL_TOLERANCE=0
ROBOT_ADMIN_EMAIL=robot@amiga.system

# Temporary reviewer workflow: an intake upload assigns every active Finance Reviewer.
REVIEWER_AUTO_ASSIGN_ON_UPLOAD=true
