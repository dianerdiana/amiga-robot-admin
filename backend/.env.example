# Backend configuration. Copy to backend/.env and adjust.
#
# Local development setup:
#   docker compose up -d db                   # from the repo root
#   cd backend
#   .venv/bin/alembic upgrade head            # schema + AMIGA Robot system user
#   .venv/bin/python -m scripts.seed_dev      # login users, demo clients, assignments
#   .venv/bin/uvicorn main:app --reload       # API + extraction worker

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amiga_robot_admin

# Alternatif: Masukkan DATABASE_URL langsung jika menggunakan remote/cloud PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amiga_robot_admin

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# ===== AWS credentials =====
# Use the IAM access key pair (not the AWS console username/password).
# Leave blank when running on an AWS host with an IAM role (EC2/ECS).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
# AWS_SESSION_TOKEN=

# ===== S3 object storage =====
S3_BUCKET_NAME=bedrock-kb-student2-1791858074
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
UPLOAD_MAX_BYTES=10485760

# ===== Bedrock extraction =====
EXTRACTION_MODE=bedrock
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_REGION=ap-southeast-1
BEDROCK_READ_TIMEOUT_SECONDS=30
BEDROCK_MAX_ATTEMPTS=2

# ===== Extraction worker =====
# Run the worker inside the API process; set to false when running it separately:
#   python -m workers.extraction_worker
EXTRACTION_RUN_IN_API=true
EXTRACTION_WORKER_THREADS=2
EXTRACTION_POLL_SECONDS=2
EXTRACTION_STALE_SECONDS=300
# EXTRACTION_FIXTURES_DIR=fixtures/extractions

# ===== Validation =====
TOTAL_TOLERANCE=0
ROBOT_ADMIN_EMAIL=robot@amiga.system
